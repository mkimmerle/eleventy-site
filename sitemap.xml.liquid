---
permalink: "/sitemap.xml"
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign blog_posts = collections.all | where_exp: "p", "p.inputPath contains '/blog/'" -%}
{%- assign newest_blog = blog_posts | sort: "data.date" | last -%}
{%- assign newest_blog_date = newest_blog.data.date -%}
{% for page in collections.all -%}
  {% if page.url and page.data.sitemap != false -%}
    {% unless page.url contains '/sass/' or page.url contains '404' or page.url contains 'offline' or page.url == '/sitemap.xml' %}
  <url>
    <loc>https://markkimmerle.com{{ page.url }}</loc>
    {%- if page.url == '/' or page.url == '/blog/' %}
    <lastmod>{{ newest_blog_date | date: "%Y-%m-%d", "UTC" }}</lastmod>
    {%- elsif page.data.updated %}
    <lastmod>{{ page.data.updated | date: "%Y-%m-%d", "UTC" }}</lastmod>
    {%- elsif page.data.date %}
    <lastmod>{{ page.data.date | date: "%Y-%m-%d", "UTC" }}</lastmod>
    {%- endif %}
  </url>
    {%- endunless -%}
  {% endif -%}
{%- endfor %}
</urlset>
